{
  "name": "query-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Analytic SQL builder for TypeScript: a core package and one package per dialect",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "tsc -b && node --test \"test/dist/unit/**/*.test.js\"",
    "test:live": "tsc -b && node --test --test-concurrency=1 \"test/dist/live/**/*.test.js\""
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.22.0"
}
