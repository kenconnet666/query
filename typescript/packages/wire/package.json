{
  "name": "@zerodep-dev/wire",
  "version": "2.1.0-dev",
  "type": "module",
  "description": "Typed JSON for the wire: bigint, Decimal, calendar dates and bytes travel as text and come back as values, guided by a $types table",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/query.git",
    "directory": "typescript/packages/wire"
  },
  "homepage": "https://github.com/kenconnet666/query#readme",
  "bugs": {
    "url": "https://github.com/kenconnet666/query/issues"
  },
  "keywords": [
    "json",
    "decimal",
    "bigint",
    "serialization",
    "api"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@internationalized/date": "3.12.4",
    "decimal.js": "10.6.0"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.12.4",
    "decimal.js": "^10.6.0"
  }
}
