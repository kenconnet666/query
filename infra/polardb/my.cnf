# Single-node X-Cluster: the node is its own Paxos group (cluster_info lists only itself), so it elects
# itself leader a few seconds after start and accepts writes. The error log goes to stderr (docker logs).
# innodb_undo_retention keeps half an hour of undo, so flashback queries (AS OF TIMESTAMP) can read back;
# innodb_scn_history_interval records the time-to-snapshot mapping every second instead of every three, so a
# moment a second or two ago already maps to a snapshot (the engine's own tests use the same setting).
[mysqld]
basedir=/opt/galaxy_engine
datadir=/data/mysql
port=3306
user=root
server_id=1
cluster_id=1
cluster_info=127.0.0.1:14886@1
character_set_server=utf8mb4
innodb_buffer_pool_size=256M
max_connections=50
performance_schema=OFF
innodb_undo_retention=1800
innodb_scn_history_interval=1
