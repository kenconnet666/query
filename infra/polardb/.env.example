# Copy to .env (git-ignored) and fill in; compose.yaml reads it automatically.
QUERY_DB_PASSWORD=
# 1 (default): table names stored in lower case and compared case-insensitively, as most PolarDB clusters are
# created; 0: case-sensitive like Linux MySQL. Fixed when the data volume is created: change it only together
# with `docker compose down -v`.
QUERY_POLARDB_LOWER_CASE_TABLE_NAMES=1
